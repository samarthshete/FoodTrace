# Copy to .env. Nothing here can incur charges.
DATABASE_URL=postgresql+asyncpg://ofs:ofs@localhost:5432/ofs
# Contact sent in the User-Agent to Open Food Facts (an email or a project URL).
OFF_CONTACT=https://github.com/samarthshete/FoodTrace
OFF_BASE_URL=https://world.openfoodfacts.org
USDA_API_KEY=DEMO_KEY  # free; get a personal key at https://api.data.gov/signup for a higher rate limit
# Optional: an Open Food Facts account, so users can share contributions with OFF (spec 017)
OFF_USER=
OFF_PASSWORD=

# Accounts (spec 018). The API checks tokens issued by the web app's Better Auth.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# In-memory cache of public API responses, in seconds (spec 025). 0 turns it off.
RESPONSE_CACHE_TTL_S=300
