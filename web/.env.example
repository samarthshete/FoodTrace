# Copy to web/.env.local. Accounts (spec 018) need these; everything else works without them.
API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Same database as the API, as a node-postgres URL (no +asyncpg).
# Production uses the Supabase session-pooler host on port 5432.
AUTH_DATABASE_URL=postgresql://ofs:ofs@localhost:5432/ofs
# Free from Google Cloud Console > APIs & Services > Credentials (OAuth client, web app).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Production redirect URI: https://<canonical-web-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: the assistant uses an LLM to understand questions (spec 023). Free key, no card:
# https://console.groq.com/keys. Without it, keyword rules are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Speech to text for the assistant mic (Whisper). Uses the same key.
GROQ_STT_MODEL=whisper-large-v3-turbo
